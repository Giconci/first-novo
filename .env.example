# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/ecommerce?schema=public"

# Login (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"

# Administrador: quem confirmar este email vira admin
ADMIN_EMAIL="seu-email@exemplo.com"
ADMIN_PASSWORD="usada só pelo seed local"

# Envio do código por email (senha de app do Gmail)
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD=""

# Mercado Pago (use a chave de TESTE: TEST-...)
MERCADOPAGO_ACCESS_TOKEN=""

# Upload de fotos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
